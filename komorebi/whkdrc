.shell powershell

# ================================================================
# Configuration Reload
# ================================================================
# alt + o                 : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
# alt + p                 : taskkill /f /im whkd.exe; start-process whkd -windowstyle hidden

# ================================================================
# System Utilities
# ================================================================
alt + shift + i            : komorebic toggle-mouse-follows-focus
alt + shift + r            : komorebic reload-configuration
alt + shift + p            : komorebic toggle-pause
alt + shift + o            : yasbc toggle-bar

# ================================================================
# Application Launcher
# ================================================================
lwin + return              : powershell.exe -WindowStyle Hidden -File "C:\Users\Masina\Documents\Script\toggle-quake.ps1"

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# alt + f                 : if ($wshell.appactivate('zen') -eq $false) { start firefox }
# alt + b                 : if ($wshell.appactivate('chrome') -eq $false) { start chrome }

# ================================================================
# Window Management - Toggles
# ================================================================
alt + q                    : komorebic close
alt + shift + i            : pwsh -WindowStyle Hidden -File "D:\Documents\Scripts\toggle.ps1"
alt + f                    : komorebic maximize
alt + m                    : komorebic minimize
alt + t                    : komorebic toggle-float
alt + shift + f            : komorebic toggle-float-override
alt + shift + t            : komorebic toggle-tiling
alt + space                : komorebic toggle-monocle

# ================================================================
# Window Focus
# ================================================================
alt + j                    : komorebic focus left
alt + k                    : komorebic focus down
alt + l                    : komorebic focus up
alt + oem_1                : komorebic focus right
alt + shift + oem_4        : komorebic cycle-focus previous # oem_4 is [
alt + shift + oem_6        : komorebic cycle-focus next # oem_6 is ]

# ================================================================
# Window Focus Alternate
#  ================================================================
alt + left                    : komorebic focus left
alt + down                    : komorebic focus down
alt + up                      : komorebic focus up
alt + right                   : komorebic focus right

# ================================================================
# Move Windows
# ================================================================
alt + shift + j            : komorebic move left
alt + shift + k            : komorebic move down
alt + shift + l            : komorebic move up
alt + shift + oem_1        : komorebic move right
alt + shift + return       : komorebic promote

# ================================================================
# Move Windows Alternate
# ================================================================
alt + shift + left            : komorebic move left
alt + shift + down            : komorebic move down
alt + shift + up              : komorebic move up
alt + shift + right           : komorebic move right

# ================================================================
# Stack Windows
# ================================================================
ctrl + shift + j           : komorebic stack left
ctrl + shift + k           : komorebic stack down
ctrl + shift + l           : komorebic stack up
ctrl + shift + oem_1       : komorebic stack right
ctrl + shift + oem_7       : komorebic unstack # oem_7 is '

# ================================================================
# Stack Windows Alternate
# ================================================================
ctrl + shift + left           : komorebic stack left
ctrl + shift + down           : komorebic stack down
ctrl + shift + up             : komorebic stack up
ctrl + shift + right          : komorebic stack right

# ================================================================
# Cycle Stack
# ================================================================
alt + oem_4                : komorebic cycle-stack previous # oem_4 is [
alt + oem_6                : komorebic cycle-stack next # oem_6 is ]

# ================================================================
# Resize Windows
# ================================================================
ctrl + shift + alt + j     : komorebic resize-axis horizontal increase
ctrl + shift + alt + oem_1 : komorebic resize-axis horizontal decrease
ctrl + shift + alt + k     : komorebic resize-axis vertical increase
ctrl + shift + alt + l     : komorebic resize-axis vertical decrease

# ================================================================
# Resize Windows Alternate
# ================================================================
ctrl + shift + alt + right     : komorebic resize-axis horizontal increase
ctrl + shift + alt + left      : komorebic resize-axis horizontal decrease
ctrl + shift + alt + up        : komorebic resize-axis vertical increase
ctrl + shift + alt + down      : komorebic resize-axis vertical decrease

# ================================================================
# Layouts
# ================================================================
alt + vk_oem_comma         : komorebic flip-layout horizontal
alt + vk_oem_period        : komorebic flip-layout vertical
ctrl + shift + vk_oem_period : komorebic cycle-layout next
ctrl + shift + vk_oem_comma  : komorebic cycle-layout previous

# ================================================================
# Workspaces - Focus
# ================================================================
alt + 1                    : komorebic focus-workspace 0
alt + 2                    : komorebic focus-workspace 1
alt + 3                    : komorebic focus-workspace 2
alt + 4                    : komorebic focus-workspace 3
alt + 5                    : komorebic focus-workspace 4
alt + 6                    : komorebic focus-workspace 5
alt + 7                    : komorebic focus-workspace 6
alt + 8                    : komorebic focus-workspace 7

# ================================================================
# Workspaces - Cycle
# ================================================================
alt + shift + vk_oem_comma : komorebic cycle-workspace previous
alt + shift + vk_oem_period : komorebic cycle-workspace next

# ================================================================
# Workspaces - Cycle - Alternate
# ================================================================
ctrl + alt + left          : komorebic cycle-workspace previous
ctrl + alt + right         : komorebic cycle-workspace next

# ================================================================
# Workspaces - Move Windows
# ================================================================
alt + shift + 1            : komorebic move-to-workspace 0
alt + shift + 2            : komorebic move-to-workspace 1
alt + shift + 3            : komorebic move-to-workspace 2
alt + shift + 4            : komorebic move-to-workspace 3
alt + shift + 5            : komorebic move-to-workspace 4
alt + shift + 6            : komorebic move-to-workspace 5
alt + shift + 7            : komorebic move-to-workspace 6
alt + shift + 8            : komorebic move-to-workspace 7
ctrl + alt + up    : komorebic cycle-move-to-workspace next
ctrl + alt + down  : komorebic cycle-move-to-workspace previous
